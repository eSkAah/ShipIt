{
  "name": "shipit",
  "version": "1.0.0",
  "description": "Production-ready SaaS boilerplate with authentication, billing, multi-tenancy, and admin capabilities",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:front": "turbo run dev --filter=front",
    "dev:back": "turbo run dev --filter=back",
    "build": "turbo run build",
    "build:front": "turbo run build --filter=front",
    "build:back": "turbo run build --filter=back",
    "test": "turbo run test",
    "test:front": "turbo run test --filter=front",
    "test:back": "turbo run test --filter=back",
    "test:front:watch": "turbo run test:watch --filter=front",
    "test:back:watch": "turbo run test:watch --filter=back",
    "test:back:e2e": "turbo run test:e2e --filter=back",
    "lint": "turbo run lint",
    "lint:front": "turbo run lint --filter=front",
    "lint:back": "turbo run lint --filter=back",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/terminus": "^10.2.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc-node/register": "^1.8.0",
    "@swc/core": "^1.3.107",
    "@swc/helpers": "^0.5.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "tsx": "^4.7.1",
    "turbo": "^2.7.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
