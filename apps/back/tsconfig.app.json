{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "CommonJS",
    "types": ["node", "multer"],
    "emitDecoratorMetadata": true,
    "target": "ES2021",
    "jsx": "react-jsx"
  },
  "exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts", "src/__mocks__/**/*"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
